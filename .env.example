NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-only salt for the demo IP rate-limit hash. Leave unset in the repo.
# COMMERCIAL_RATE_LIMIT_SALT=

# Commercial payment sandboxes. Server-only. Never use NEXT_PUBLIC_* for these values.
# Leave them unset in the repository. MOBBEX_TEST_MODE must be true outside production.
# TALO_SANDBOX_API_URL must be https://sandbox-api.talo.com.ar
# Put the Talo sandbox credential in .env.local, not in this file.
# MOBBEX_API_KEY=
# MOBBEX_ACCESS_TOKEN=
# MOBBEX_TEST_MODE=
# TALO_SANDBOX_API_URL=
# TALO_USER_ID=
# TALO_CLIENT_ID=
# TALO_CLIENT_SECRET=
# COMMERCIAL_PAYMENT_WEBHOOK_BASE_URL=
# COMMERCIAL_TALO_WEBHOOK_SANDBOX=
# COMMERCIAL_TALO_WEBHOOK_LISTENER=

    "views": [
      {
        "name": "statistics_v1_effective_facts",
        "options": [
          "security_invoker=true",
          "security_barrier=true"
        ],
        "definition": " SELECT c.id,\n    c.business_id,\n    c.order_id,\n    c.cycle,\n    c.completed_at,\n    c.source_kind,\n    c.session_id,\n    c.session_key,\n    c.session_opened_at,\n    c.timezone,\n    c.commercial_date,\n    c.date_kind,\n    c.active,\n    c.invalidated_at,\n    c.invalidation_reason,\n    c.agreed_total,\n    c.products_net,\n    c.delivery,\n    c.breakdown_source,\n    c.agreement_evidence_id,\n    c.composition_status,\n    c.composition_digest,\n    c.gross_products,\n    c.main_units,\n    c.monetary_conflict,\n    c.composition_conflict,\n    c.date_conflict,\n    c.contract_version,\n    f.agreed_total AS current_agreement,\n    ((c.commercial_date IS NOT NULL) AND (c.timezone IS NOT NULL) AND (NOT c.date_conflict)) AS date_reliable,\n        CASE\n            WHEN ((NOT c.composition_conflict) AND (c.composition_digest = private.statistics_source_digest(private.statistics_source_items(c.order_id, c.business_id)))) THEN c.main_units\n            ELSE NULL::bigint\n        END AS effective_units,\n        CASE\n            WHEN ((NOT c.monetary_conflict) AND (NOT c.composition_conflict) AND (NOT (c.agreed_total IS DISTINCT FROM f.agreed_total)) AND (c.breakdown_source = 'copy_total_price'::text) AND (c.composition_digest = private.statistics_source_digest(private.statistics_source_items(c.order_id, c.business_id)))) THEN c.agreed_total\n            ELSE NULL::numeric\n        END AS effective_sales,\n    array_remove(ARRAY[\n        CASE\n            WHEN (c.agreed_total IS NULL) THEN 'missing_agreement'::text\n            ELSE NULL::text\n        END,\n        CASE\n            WHEN (c.breakdown_source = 'unresolved'::text) THEN 'unresolved_breakdown'::text\n            ELSE NULL::text\n        END,\n        CASE\n            WHEN (c.monetary_conflict OR (c.agreed_total IS DISTINCT FROM f.agreed_total)) THEN 'agreement_changed_after_completion'::text\n            ELSE NULL::text\n        END,\n        CASE\n            WHEN (c.composition_conflict OR (c.composition_digest <> private.statistics_source_digest(private.statistics_source_items(c.order_id, c.business_id)))) THEN 'source_conflict'::text\n            ELSE NULL::text\n        END,\n        CASE\n            WHEN (c.main_units IS NULL) THEN 'missing_composition'::text\n            ELSE NULL::text\n        END], NULL::text) AS reasons\n   FROM ((order_statistics_completions c\n     JOIN orders o ON (((o.id = c.order_id) AND (o.business_id = c.business_id) AND (o.status = 'completed'::text))))\n     LEFT JOIN order_financials f ON (((f.order_id = c.order_id) AND (f.business_id = c.business_id))))\n  WHERE (c.active AND private.statistics_can_read(c.business_id));"
      }
    ],
